---
/**
 * PartnerInquiryFormStitch.astro
 * Partner inquiry form — submits via Web3Forms (no backend needed).
 */
---

<section class="bg-[#200f01] py-24 px-6" aria-labelledby="form-heading">
  <div class="max-w-4xl mx-auto">

    <div class="bg-[#2f1b08] rounded-[2rem] p-8 md:p-14 shadow-2xl border-t-8 border-[#ce0301] relative overflow-hidden">
      <!-- Subtle corner accent -->
      <div class="absolute top-0 right-0 w-48 h-48 bg-[#ce0301] opacity-5 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

      <div class="mb-10 text-center space-y-2">
        <h2 id="form-heading" class="text-3xl md:text-4xl font-headline font-black text-white uppercase tracking-tighter">
          Partner Inquiry
        </h2>
        <p class="text-[#d0c6ab] font-medium">
          Interested in distributing Coco Cado? Share your details and our team will get in touch.
        </p>
      </div>

      <!-- Success Message (hidden by default) -->
      <div id="partner-success" class="hidden flex-col items-center justify-center text-center py-12 space-y-4">
        <div class="w-20 h-20 bg-green-500 rounded-full flex items-center justify-center shadow-lg mb-2">
          <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
        </div>
        <h3 class="font-headline font-black text-2xl uppercase text-white tracking-tight">Inquiry Received!</h3>
        <p class="text-[#d0c6ab] text-base">Thank you for your interest in partnering with Coco Cado. Our team will be in touch within 2–3 business days.</p>
        <button
          id="partner-reset"
          class="mt-4 bg-[#ffd700] text-[#221b00] font-headline font-black text-sm uppercase px-6 py-3 rounded-full hover:scale-105 transition-transform"
        >
          Submit Another Inquiry
        </button>
      </div>

      <!-- Error Message (hidden by default) -->
      <div id="partner-error" class="hidden bg-red-900/40 border-2 border-red-500 rounded-2xl p-4 mb-6 text-center">
        <p class="text-red-300 font-medium text-sm">Something went wrong. Please try again or email us directly at <span class="text-[#ffd700]">cococado@happyalliance.com</span></p>
      </div>

<form id="partner-form" class="space-y-6" action="https://formspree.io/f/xojbqkvw" method="POST">
  <input type="hidden" name="_subject" value="New Partner Inquiry – Coco Cado" />
  <input type="text" name="_gotcha" style="display:none" />

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

          <div class="space-y-2">
            <label for="company-name" class="block font-headline font-bold text-xs uppercase tracking-wider text-[#ffd700]">
              Company Name
            </label>
            <input
              id="company-name"
              name="company-name"
              type="text"
              required
              placeholder="Your Business Ltd."
              class="w-full bg-[#200f01] border-2 border-[#4d4732] rounded-xl px-4 py-3 text-white placeholder:text-[#999077] focus:border-[#ffd700] focus:outline-none transition-colors"
            />
          </div>

          <div class="space-y-2">
            <label for="country" class="block font-headline font-bold text-xs uppercase tracking-wider text-[#ffd700]">
              Country / Market
            </label>
            <input
              id="country"
              name="country"
              type="text"
              required
              placeholder="e.g. Malaysia, Singapore, UK"
              class="w-full bg-[#200f01] border-2 border-[#4d4732] rounded-xl px-4 py-3 text-white placeholder:text-[#999077] focus:border-[#ffd700] focus:outline-none transition-colors"
            />
          </div>

          <div class="space-y-2">
            <label for="contact-name" class="block font-headline font-bold text-xs uppercase tracking-wider text-[#ffd700]">
              Contact Person
            </label>
            <input
              id="contact-name"
              name="contact-name"
              type="text"
              required
              placeholder="Full Name"
              class="w-full bg-[#200f01] border-2 border-[#4d4732] rounded-xl px-4 py-3 text-white placeholder:text-[#999077] focus:border-[#ffd700] focus:outline-none transition-colors"
            />
          </div>

          <div class="space-y-2">
            <label for="email" class="block font-headline font-bold text-xs uppercase tracking-wider text-[#ffd700]">
              Email / Phone
            </label>
            <input
              id="email"
              name="email"
              type="email"
              required
              placeholder="contact@company.com"
              class="w-full bg-[#200f01] border-2 border-[#4d4732] rounded-xl px-4 py-3 text-white placeholder:text-[#999077] focus:border-[#ffd700] focus:outline-none transition-colors"
            />
          </div>

          <div class="space-y-2">
            <label for="business-type" class="block font-headline font-bold text-xs uppercase tracking-wider text-[#ffd700]">
              Business Type
            </label>
            <select
              id="business-type"
              name="business-type"
              required
              class="w-full bg-[#200f01] border-2 border-[#4d4732] rounded-xl px-4 py-3 text-white focus:border-[#ffd700] focus:outline-none transition-colors appearance-none cursor-pointer"
            >
              <option value="" disabled selected>Select Business Type</option>
              <option value="importer">Importer</option>
              <option value="national-distributor">National Distributor</option>
              <option value="wholesaler">Wholesaler</option>
              <option value="retailer">Retailer</option>
            </select>
          </div>

          <div class="space-y-2">
            <label for="product-category" class="block font-headline font-bold text-xs uppercase tracking-wider text-[#ffd700]">
              Product Category
            </label>
            <select
              id="product-category"
              name="product-category"
              class="w-full bg-[#200f01] border-2 border-[#4d4732] rounded-xl px-4 py-3 text-white focus:border-[#ffd700] focus:outline-none transition-colors appearance-none cursor-pointer"
            >
              <option value="" disabled selected>Select Category</option>
              <option value="popping-pearl">Popping Pearl</option>
              <option value="potato-sticks">Potato Sticks</option>
              
              <option value="multiple">Multiple Categories</option>
            </select>
          </div>

        </div>

        <div class="space-y-2">
          <label for="coverage" class="block font-headline font-bold text-xs uppercase tracking-wider text-[#ffd700]">
            Distribution Coverage
          </label>
          <input
            id="coverage"
            name="coverage"
            type="text"
            placeholder="e.g. Nationwide coverage, specific regions only"
            class="w-full bg-[#200f01] border-2 border-[#4d4732] rounded-xl px-4 py-3 text-white placeholder:text-[#999077] focus:border-[#ffd700] focus:outline-none transition-colors"
          />
        </div>

        <div class="space-y-2">
          <label for="message" class="block font-headline font-bold text-xs uppercase tracking-wider text-[#ffd700]">
            Message
          </label>
          <textarea
            id="message"
            name="message"
            rows="4"
            placeholder="Tell us more about your distribution network..."
            class="w-full bg-[#200f01] border-2 border-[#4d4732] rounded-xl px-4 py-3 text-white placeholder:text-[#999077] focus:border-[#ffd700] focus:outline-none transition-colors resize-none"
          ></textarea>
        </div>

        <div class="pt-2">
          <button
            type="submit"
            id="partner-submit-btn"
            class="w-full bg-[#ce0301] text-white py-5 rounded-xl font-headline font-black text-xl uppercase tracking-tighter hover:scale-[1.02] hover:rotate-1 active:scale-95 transition-all shadow-[0_8px_0_#6a0000] border-2 border-[#6a0000] disabled:opacity-60 disabled:cursor-not-allowed"
          >
            Send Inquiry
          </button>
        </div>

      </form>
    </div>

  </div>
</section>

<script>
  const form = document.getElementById('partner-form') as HTMLFormElement;
  const successDiv = document.getElementById('partner-success') as HTMLElement;
  const errorDiv = document.getElementById('partner-error') as HTMLElement;
  const submitBtn = document.getElementById('partner-submit-btn') as HTMLButtonElement;
  const resetBtn = document.getElementById('partner-reset') as HTMLButtonElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    // Hide any previous error
    errorDiv.classList.add('hidden');

    // Loading state
    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending...';

    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());

    try {
      const response = await fetch('https://formspree.io/f/xojbqkvw', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      const result = await response.json();

if (result.ok || result.success) {
        // Show success, hide form
        form.classList.add('hidden');
        successDiv.classList.remove('hidden');
        successDiv.classList.add('flex');
      } else {
        throw new Error('Submission failed');
      }
    } catch {
      // Show error message
      errorDiv.classList.remove('hidden');
      submitBtn.disabled = false;
      submitBtn.textContent = 'Send Inquiry';
    }
  });

  // Reset button — show form again
  resetBtn.addEventListener('click', () => {
    form.reset();
    form.classList.remove('hidden');
    successDiv.classList.add('hidden');
    successDiv.classList.remove('flex');
    submitBtn.disabled = false;
    submitBtn.textContent = 'Send Inquiry';
  });
</script>