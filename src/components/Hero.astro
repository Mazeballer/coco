---
import { Image } from "astro:assets";
import homeImage from "../assets/home.png";
import homePearlImage from "../assets/home-pearl.png";
---

<section
  id="hero-scroll"
  class="relative h-auto md:h-screen md:overflow-hidden bg-[#f2cdff]"
  aria-label="Coco Cado product showcase"
>
  <div id="hero-panels" class="hero-panels flex flex-col w-full md:h-[200vh] md:-translate-y-1/2">

    <!-- PANEL 1 (POTATO STICKS) - HIDDEN ON MOBILE -->
    <div
      class="hero-panel hidden md:flex relative h-auto md:h-screen w-full shrink-0 bg-[#ffd700] items-stretch"
      aria-labelledby="hero-heading-1"
    >
      <div class="absolute top-1/2 right-1/4 translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-[#ce0301]/20 blur-[100px] rounded-full pointer-events-none" aria-hidden="true"></div>

      <div class="container mx-auto px-6 relative z-10 flex flex-col md:flex-row-reverse items-stretch">
        <div class="hero-content-col w-full md:w-1/2 text-left md:text-right space-y-8 md:pl-12 flex flex-col justify-center pt-32 md:pt-44 pb-10">
          <div class="relative inline-block panel2-fade">
            <h2 id="hero-heading-1" class="relative z-10 text-[clamp(2.5rem,1rem+4vw,4.5rem)] font-black font-headline text-[#200f01] leading-[0.9] tracking-tight mb-4 text-balance">
              Snack Happy <br />with <span class="text-[#ce0301]">Coco Cado!</span>
            </h2>
            <div class="absolute -top-20 right-0 md:-top-24 md:right-0 lg:-top-20 lg:right-0 w-20 h-20 sm:w-24 sm:h-24 bg-[#f2cdff] rounded-full flex items-center justify-center rotate-12 shadow-2xl border-4 border-[#200f01] z-0 hover:scale-110 transition-transform cursor-default" aria-label="Made from Real Potatoes">
              <span class="text-[#8243a2] font-black font-accent text-center text-xs sm:text-sm leading-tight uppercase">Real<br />Potatoes!</span>
            </div>
          </div>

          <p class="text-xl md:text-xl lg:text-2xl font-medium text-[#200f01]/80 max-w-lg md:ml-auto panel2-slide">
            Bold flavour, crunchy fun, and feel-good snacking for every moment.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 md:justify-end panel2-slide">
            <span class="bg-[#ce0301] text-white px-5 lg:px-6 py-2.5 lg:py-3 rounded-xl font-black text-sm lg:text-base border-b-4 border-[#200f01] shadow-xl hover:rotate-2 hover:scale-105 transition-all active:scale-95 text-center">🍅 Tomato</span>
            <span class="bg-[#200f01] text-[#ffd700] px-5 lg:px-6 py-2.5 lg:py-3 rounded-xl font-black text-sm lg:text-base border-b-4 border-[#999077] hover:-rotate-2 hover:scale-105 transition-all active:scale-95 text-center">🌶 Black Pepper</span>
            <span class="bg-transparent border-4 border-[#200f01] text-[#200f01] px-5 lg:px-6 py-2.5 lg:py-3 rounded-xl font-black text-sm lg:text-base hover:rotate-1 hover:scale-105 transition-all active:scale-95 text-center">🧂 Salted</span>
          </div>
        </div>

        <div class="w-full md:w-1/2 relative flex items-center justify-center panel2-bounce pb-64 md:pb-0">
          <div class="relative z-10 transform -rotate-6 hover:rotate-0 transition-transform duration-700 w-4/5 sm:w-2/3 md:w-full">
            <Image
              src={homeImage}
              alt="Coco Cado Potato Sticks in three flavours — Salted, Black Pepper, and Tomato"
              widths={[400, 800, 1200, 1600]}
              sizes="(max-width: 768px) 400px, 1600px"
              quality="mid"
              loading="lazy"
              class="w-auto h-auto max-w-full max-h-[clamp(18rem,84vh,46rem)] object-contain mx-auto drop-shadow-[0_35px_35px_rgba(32,15,1,0.4)]"
            />
          </div>
          <div class="absolute top-0 left-0 w-64 h-64 bg-[#ffd700] rounded-full mix-blend-multiply filter blur-xl opacity-70 animate-pulse pointer-events-none" aria-hidden="true"></div>
        </div>
      </div>
    </div>

    <!-- PANEL 2 (POPPING PEARLS) -->
    <div
      class="hero-panel relative h-auto md:h-screen w-full shrink-0 bg-[#f2cdff] flex items-stretch"
      aria-labelledby="hero-heading-2"
    >
      <div class="absolute top-1/2 left-1/4 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-[#ce0301]/20 blur-[100px] rounded-full pointer-events-none" aria-hidden="true"></div>

      <div class="container mx-auto px-6 relative z-10 flex flex-col md:flex-row items-stretch">
        <div class="hero-content-col w-full md:w-1/2 text-left space-y-8 flex flex-col justify-center pt-6 md:pt-44 pb-10 order-2 md:order-1">
          <div class="relative inline-block panel1-fade">
            <h1 id="hero-heading-2" class="relative z-10 text-[clamp(2.5rem,1rem+4vw,4.5rem)] font-black font-headline text-[#200f01] leading-[0.9] tracking-tight mb-4 text-balance">
              Burst of Joy <br />with <span class="text-[#ce0301]">Coco Cado!</span>
            </h1>
            <div class="absolute -top-20 right-0 md:-top-24 md:left-0 lg:-top-20 lg:left-0 w-20 h-20 sm:w-24 sm:h-24 bg-[#ffd700] rounded-full flex items-center justify-center -rotate-12 shadow-2xl border-4 border-[#200f01] z-0 hover:scale-110 transition-transform cursor-default" aria-label="Popping Pearl Snacks">
              <span class="text-[#ce0301] font-black font-accent text-center text-xs sm:text-sm leading-tight uppercase">Pop<br />Ready!</span>
            </div>
          </div>

          <p class="text-xl md:text-xl lg:text-2xl font-medium text-[#200f01]/80 max-w-lg panel1-slide">
            Juicy pearls, playful flavour, and a refreshing pop in every pouch.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 panel1-slide">
            <span class="flex items-center justify-center gap-2 bg-[#ce0301] text-white px-5 lg:px-6 py-2.5 lg:py-3 rounded-xl font-black text-sm lg:text-base border-b-4 border-[#200f01] shadow-xl hover:rotate-2 hover:scale-105 transition-all active:scale-95 text-center">
              🌾 Barley
            </span>
            <span class="flex items-center justify-center gap-2 bg-[#200f01] text-[#ffd700] px-5 lg:px-6 py-2.5 lg:py-3 rounded-xl font-black text-sm lg:text-base border-b-4 border-[#999077] hover:-rotate-2 hover:scale-105 transition-all active:scale-95 text-center">
              🫘 Red Bean
            </span>
            <span class="flex items-center justify-center gap-2 bg-transparent border-4 border-[#200f01] text-[#200f01] px-5 lg:px-6 py-2.5 lg:py-3 rounded-xl font-black text-sm lg:text-base hover:rotate-1 hover:scale-105 transition-all active:scale-95 text-center">
              🌰 Water Chestnut
            </span>
          </div>
        </div>

        <div class="w-full md:w-1/2 relative flex items-center justify-center panel1-bounce pt-28 md:pt-0 pb-6 md:pb-0 order-first md:order-2">
          <div class="relative z-10 transform rotate-6 hover:rotate-0 transition-transform duration-700 w-4/5 sm:w-2/3 md:w-full">
            <Image
              src={homePearlImage}
              alt="Coco Cado Popping Pearl in three flavours — Red Bean, Barley, and Water Chestnut"
              widths={[400, 800, 1200, 1600]}
              sizes="(max-width: 768px) 400px, 1600px"
              quality="mid"
              loading="eager"
              fetchpriority="high"
              class="w-auto h-auto max-w-full max-h-[clamp(18rem,84vh,46rem)] object-contain mx-auto drop-shadow-[0_35px_35px_rgba(32,15,1,0.4)]"
            />
          </div>
          <div class="absolute top-0 right-0 w-64 h-64 bg-[#ffd700] rounded-full mix-blend-multiply filter blur-xl opacity-70 animate-pulse pointer-events-none" aria-hidden="true"></div>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  /* ── Pearl panel entrance animations (CSS-only, no JS dependency) ──
     These run the moment the browser parses the stylesheet — no blank
     background flash even on slow connections.                          */

  .panel1-fade {
    animation: heroCrossFade 0.6s ease-out both;
  }

  .panel1-slide {
    animation: heroSlideUp 0.7s ease-out both;
    animation-delay: 0.1s;
  }

  .panel1-bounce {
    animation: heroBounceIn 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }

  @keyframes heroCrossFade {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  @keyframes heroSlideUp {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes heroBounceIn {
    from { opacity: 0; transform: scale(0.88); }
    to   { opacity: 1; transform: scale(1); }
  }

  /* Respect reduced-motion preference */
  @media (prefers-reduced-motion: reduce) {
    .panel1-fade,
    .panel1-slide,
    .panel1-bounce {
      animation: none;
    }
  }

  /* ── Height-responsive: only fires below 740px height ──
     768px (standard Windows laptop) is intentionally excluded so it gets
     the full Mac-matching layout. Only truly short screens get compressed. */
  @media (max-height: 740px) and (min-width: 768px) {
    .hero-content-col {
      padding-top: 5rem !important;
      padding-bottom: 1rem !important;
    }
  }

  @media (max-height: 650px) and (min-width: 768px) {
    .hero-content-col {
      padding-top: 3rem !important;
    }
    #hero-heading-1,
    #hero-heading-2 {
      font-size: 3rem !important;
      line-height: 0.9 !important;
    }
  }

  /* ── Short-height + wide-width windows (e.g. a non-maximised window or
     a Windows laptop screen): wide enough for the two-column layout but
     not tall. Only this viewport class is adjusted — taller screens
     (Mac, normal desktop) and mobile keep their approved layout. ──
       • looser line-height so the "Joy" descender clears "Coco Cado!"
       • tighter vertical rhythm so the heading sits nearer the paragraph */
  @media (min-width: 1024px) and (max-height: 820px) {
    .hero-content-col {
      /* enough top space so the POP READY badge clears the fixed navbar /
         COCO CADO logo, but not so much that the block floats too low */
      padding-top: 8rem !important;
      padding-bottom: 1rem !important;
    }
    #hero-heading-1,
    #hero-heading-2 {
      line-height: 1.08 !important;
      margin-bottom: 0 !important;
    }
    .hero-content-col > :not([hidden]) ~ :not([hidden]) {
      margin-top: -1rem !important;
    }
    .hero-content-col p {
      line-height: 1.3 !important;
    }
  }
</style>
